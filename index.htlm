<!DOCTYPE html>
<html lang="pl"><head>
<meta charset="utf-8">
<!-- This site is hosted on Netlify. Anyone can build and deploy a site
     like this one for free: https://netlify.new/?utm_campaign=loops&utm_source=ai-legible&utm_medium=owned&utm_content=comment&utm_id=daf0c345-fcfc-4a93-b47b-e9738a1ea8da
     Netlify hosting facts for this site: static/SSR served via Netlify Edge. -->
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>X-Studio – serwery Minecraft od xFezuuPL</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@600;900&amp;family=Manrope:wght@400;600&amp;display=swap">
<style>
:root{color-scheme:dark;--bg:#000;--ink:#fff;--mut:#a8a8a8;--red:#e10600;--line:#2a2a2a;--panel:#0d0d0d;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ink);font:400 17px/1.6 Manrope,system-ui,sans-serif}
h1,h2,h3{font-family:Unbounded,Impact,sans-serif;margin:0;line-height:1.05}
a{color:inherit}
:focus-visible{outline:3px solid var(--red);outline-offset:3px}
.wrap{max-width:1040px;margin:0 auto;padding:0 22px}
nav{display:flex;justify-content:space-between;align-items:center;padding:22px 0;border-bottom:1px solid var(--line)}
.logo{font-family:Unbounded,sans-serif;font-weight:900;text-decoration:none;font-size:20px}
.logo b{color:var(--red)}
nav ul{display:flex;gap:26px;list-style:none;margin:0;padding:0}
nav a{text-decoration:none;color:var(--mut)}nav a:hover{color:var(--ink)}
.hero{position:relative;padding:90px 0 80px;overflow:hidden}
.hero h1{font-weight:900;font-size:clamp(46px,11vw,128px);letter-spacing:-.03em}
.hero h1 .x{color:var(--red)}
.hero p{max-width:520px;color:var(--mut);margin:26px 0 34px;font-size:19px}
.btn{display:inline-block;background:var(--red);color:#fff;font:600 16px Manrope,sans-serif;padding:15px 28px;text-decoration:none;border:2px solid var(--red);transition:background .2s,color .2s}
.btn:hover{background:#fff;color:#000;border-color:#fff}
.btn.ghost{background:transparent;color:#fff;border-color:#fff;margin-left:10px}
.btn.ghost:hover{background:#fff;color:#000}
.bigx{position:absolute;right:-40px;top:20px;font:900 clamp(260px,42vw,520px)/1 Unbounded,sans-serif;color:var(--red);opacity:.13;pointer-events:none;user-select:none}
section{padding:70px 0;border-top:1px solid var(--line)}
h2{font-size:clamp(28px,5vw,46px);margin-bottom:12px}
.lead{color:var(--mut);max-width:560px;margin:0 0 38px}
.offer{display:grid;grid-template-columns:1.3fr 1fr;border:2px solid #fff;background:var(--panel)}
.offer>div{padding:36px}
.offer .left{border-right:2px solid #fff}
.offer h3{font-size:clamp(24px,4vw,34px);margin-bottom:16px}
.offer ul{padding-left:20px;margin:18px 0 0;color:#d6d6d6}
.offer li{margin-bottom:8px}
.offer li::marker{color:var(--red)}
.right{display:flex;flex-direction:column;justify-content:center;background:var(--red)}
.price{font:900 clamp(60px,9vw,92px)/1 Unbounded,sans-serif}
.price small{font-size:.35em;margin-left:6px}
.right p{margin:10px 0 24px}
.right .btn{background:#000;border-color:#000;text-align:center}
.right .btn:hover{background:#fff;color:#000;border-color:#fff}
#projekty-lista{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:20px}
.proj{border:1px solid var(--line);background:var(--panel);padding:22px;border-left:4px solid var(--red)}
.proj h3{font-size:19px;margin-bottom:8px}
.proj p{margin:0;color:var(--mut);font-size:15px}
.empty{border:1px dashed #555;padding:34px;color:var(--mut);grid-column:1/-1}
.dc{font:600 clamp(24px,5vw,38px)/1.2 Unbounded,sans-serif;margin:0 0 24px}.dc strong{color:var(--red)}
button.btn{cursor:pointer}
#admin{border:2px solid var(--red);background:var(--panel);padding:26px;margin:30px 0}
#admin h3{font-size:22px;margin:22px 0 12px}
#admin input,#admin textarea{width:100%;background:#000;color:#fff;border:1px solid #555;padding:11px;font:inherit;margin-bottom:10px}
#admin .row{display:flex;gap:10px;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);padding:8px 0}
#admin .btn{padding:10px 18px;font-size:15px}.btn.sm{padding:7px 14px;font-size:14px;background:#000;border-color:#555}
#msg{margin-top:14px;color:var(--mut)}
.linkbtn{background:none;border:0;color:var(--mut);font:inherit;cursor:pointer;text-decoration:underline;padding:0}
footer{border-top:1px solid var(--line);padding:30px 0;color:var(--mut);font-size:15px}
@media(max-width:760px){nav ul{display:none}.offer{grid-template-columns:1fr}.offer .left{border-right:0;border-bottom:2px solid #fff}.offer>div{padding:26px}.btn.ghost{margin:12px 0 0}.bigx{right:-90px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}
</style>
</head>
<body>
<div class="wrap">
<nav><a class="logo" href="#"><b>X</b>-Studio</a>
<ul><li><a href="#oferta">Oferta</a></li><li><a href="#projekty">Projekty</a></li><li><a href="#kontakt">Kontakt</a></li></ul></nav>

<header class="hero">
<div class="bigx" aria-hidden="true">X</div>
<h1><span class="x">X</span>-Studio</h1>
<p>Serwery Minecraft robione od zera przez xFezuuPL. Ty masz pomysł, ja buduję serwer.</p>
<a class="btn" href="#oferta">Zobacz ofertę</a><a class="btn ghost" href="#projekty">Moje projekty</a>
</header>

<section id="oferta">
<h2>Oferta</h2>
<p class="lead">Wybierz usługę, napisz do mnie i zaczynamy.</p>
<div id="oferty"></div>
</section>

<section id="projekty">
<h2>Projekty</h2>
<p class="lead">Serwery, które stworzyło X-Studio.</p>
<div id="projekty-lista"></div>
</section>

<section id="kontakt">
<h2>Kontakt</h2>
<p class="lead">Napisz do mnie na Discordzie, podaj jaki serwer chcesz stworzyć i umówimy szczegóły oraz płatność.</p>
<p class="dc">Discord: <strong id="dc-nick">https://discord.gg/NuzEFAnT7</strong></p>
<button class="btn" id="kontakt-btn" type="button">Skopiuj nick</button><a class="btn ghost" id="dc-link" href="https://discord.gg/NuzEFAnT7" target="_blank" rel="noopener">Dołącz na Discorda</a>
</section>
</div>

<footer><div class="wrap"><div id="admin" hidden=""><h2>Panel admina</h2><div id="admin-body"></div><div id="msg" role="status"></div></div>© <span id="rok">2026</span> X-Studio, stworzone przez xFezuuPL · <button class="linkbtn" id="admin-open" type="button">Panel admina</button></div></footer>
<script type="application/json" id="dane">{"oferty":[{"tytul":"Współpraca serwerowa","opis":"Kupujesz współpracę, a ja tworzę dla Ciebie serwer Minecraft. Pracujemy razem, aż będzie gotowy.","punkty":["Serwer tworzony od początku do końca przeze mnie","Jedna płatność, bez abonamentu","Płacisz jednorazowo, a współpraca trwa do końca tworzenia serwera"],"cena":"60","jednostka":"zł","opisCeny":"Płatność jednorazowa"}],"projekty":[],"discord":{"nick":"https://discord.gg/NuzEFAnT7","link":"https://discord.gg/NuzEFAnT7"},"v":1792005457001}</script>

<script>
var HASH="50a0da180e167ee7b284180a567afbc38f126fbb9f372c80d5ea1932a064af8b";
var KEY="xstudio-dane";
var stan=JSON.parse(document.getElementById("dane").textContent);
try{var z=JSON.parse(localStorage.getItem(KEY)||"null");if(z&&(z.v||0)>=(stan.v||0)&&z.oferty&&z.projekty)stan=z}catch(e){}
if(!stan.discord)stan.discord={nick:"xfezuupl",link:""};
function lok(){stan.v=Date.now();try{localStorage.setItem(KEY,JSON.stringify(stan))}catch(e){}}
function el(t,c,x){var e=document.createElement(t);if(c)e.className=c;if(x!==undefined)e.textContent=x;return e}
function render(){
  document.getElementById("dc-nick").textContent=stan.discord.nick||"";
  var dl=document.getElementById("dc-link"),lk=(stan.discord.link||"").trim();
  if(/^https?:\/\//i.test(lk)){dl.href=lk;dl.hidden=false}else{dl.hidden=true}
  var o=document.getElementById("oferty");o.innerHTML="";
  stan.oferty.forEach(function(f){
    var art=el("article","offer"),l=el("div","left"),r=el("div","right");
    l.appendChild(el("h3","",f.tytul));l.appendChild(el("p","",f.opis));
    if(f.punkty&&f.punkty.length){var u=el("ul");f.punkty.forEach(function(x){u.appendChild(el("li","",x))});l.appendChild(u)}
    var pr=el("div","price",f.cena);pr.appendChild(el("small","",f.jednostka||""));r.appendChild(pr);
    r.appendChild(el("p","",f.opisCeny||""));
    var b=el("a","btn","Zamawiam");b.href="#kontakt";r.appendChild(b);
    art.appendChild(l);art.appendChild(r);o.appendChild(art);o.appendChild(el("div")).style.height="20px";
  });
  var lista=document.getElementById("projekty-lista");lista.innerHTML="";
  if(!stan.projekty.length)lista.appendChild(el("div","empty","Pierwsze projekty pojawią się tu wkrótce."));
  stan.projekty.forEach(function(p){var d=el("div","proj");d.appendChild(el("h3","",p.nazwa));d.appendChild(el("p","",p.opis));lista.appendChild(d)});
  if(!document.getElementById("admin").hidden&&document.getElementById("admin-body").firstChild)panel();
}
function msg(t){document.getElementById("msg").textContent=t}
async function sha(t){var b=await crypto.subtle.digest("SHA-256",new TextEncoder().encode(t));return Array.from(new Uint8Array(b)).map(function(x){return x.toString(16).padStart(2,"0")}).join("")}
function pole(body,ph,multi){var i=el(multi?"textarea":"input");i.placeholder=ph;if(multi)i.rows=4;body.appendChild(i);return i}
function lista(body,tytul,arr,nazwa){
  body.appendChild(el("h3","",tytul));
  if(!arr.length)body.appendChild(el("p","","Brak."));
  arr.forEach(function(x,i){var r=el("div","row");r.appendChild(el("span","",nazwa(x)));
    var d=el("button","btn sm","Usuń");d.type="button";d.onclick=function(){arr.splice(i,1);lok();render();msg("Usunięto i zapisano w tej przeglądarce.")};r.appendChild(d);body.appendChild(r)});
}
function panel(){
  var body=document.getElementById("admin-body");body.innerHTML="";
  lista(body,"Oferty",stan.oferty,function(x){return x.tytul+" – "+x.cena+" "+(x.jednostka||"")});
  body.appendChild(el("h3","","Dodaj ofertę"));
  var t=pole(body,"Tytuł oferty"),o=pole(body,"Opis",1),pk=pole(body,"Punkty oferty, każdy w osobnej linii",1),c=pole(body,"Cena (sama liczba, np. 60)"),j=pole(body,"Waluta, np. zł"),oc=pole(body,"Opis pod ceną, np. Płatność jednorazowa");
  var ab=el("button","btn","Dodaj ofertę");ab.type="button";
  ab.onclick=function(){if(!t.value.trim()||!c.value.trim()){msg("Podaj tytuł i cenę.");return}
    stan.oferty.push({tytul:t.value.trim(),opis:o.value.trim(),punkty:pk.value.split("\n").map(function(x){return x.trim()}).filter(Boolean),cena:c.value.trim(),jednostka:j.value.trim(),opisCeny:oc.value.trim()});
    lok();render();panel();msg("Dodano i zapisano w tej przeglądarce. Żeby widzieli to odwiedzający, pobierz plik strony i wgraj go na hosting.")};body.appendChild(ab);
  lista(body,"Projekty",stan.projekty,function(x){return x.nazwa});
  body.appendChild(el("h3","","Dodaj projekt"));
  var pn=pole(body,"Nazwa projektu"),po=pole(body,"Opis projektu",1);
  var pb=el("button","btn","Dodaj projekt");pb.type="button";
  pb.onclick=function(){if(!pn.value.trim()){msg("Podaj nazwę projektu.");return}
    stan.projekty.push({nazwa:pn.value.trim(),opis:po.value.trim()});lok();render();panel();msg("Dodano i zapisano w tej przeglądarce. Żeby widzieli to odwiedzający, pobierz plik strony i wgraj go na hosting.")};body.appendChild(pb);
  body.appendChild(el("h3","","Discord"));
  var dn=pole(body,"Nick na Discordzie");dn.value=stan.discord.nick||"";
  var dk=pole(body,"Link do Discorda (np. https://discord.gg/xxxx), może zostać pusty");dk.value=stan.discord.link||"";
  var db=el("button","btn","Zapisz Discorda");db.type="button";
  db.onclick=function(){var l=dk.value.trim();if(l&&!/^https?:\/\//i.test(l)){msg("Link musi zaczynać się od https://");return}
    stan.discord={nick:dn.value.trim(),link:l};lok();render();msg("Zapisano Discorda w tej przeglądarce. Pobierz plik strony, żeby widzieli to odwiedzający.")};body.appendChild(db);
  body.appendChild(el("h3","","Zapis dla odwiedzających"));
  body.appendChild(el("p","","Zmiany zapisują się w tej przeglądarce. Aby widzieli je wszyscy, pobierz plik i wgraj go na hosting w miejsce starego."));
  var pb2=el("button","btn","Pobierz plik strony (index.html)");pb2.type="button";pb2.onclick=pobierz;body.appendChild(pb2);
  if(window.claude&&window.claude.use){var sb=el("button","btn ghost","Zapisz na claude.ai");sb.type="button";sb.onclick=zapisz;body.appendChild(sb)}
}
function html(){
  lok();
  var c=document.documentElement.cloneNode(true);
  ["oferty","projekty-lista","admin-body","msg"].forEach(function(id){c.querySelector("#"+id).textContent=""});
  c.querySelector("#admin").hidden=true;
  c.querySelector("#dane").textContent=JSON.stringify(stan).replace(/</g,"\\u003c");
  return "<!DOCTYPE html>\n"+c.outerHTML;
}
function pobierz(){
  var u=URL.createObjectURL(new Blob([html()],{type:"text/html"}));
  var a=el("a");a.href=u;a.download="index.html";document.body.appendChild(a);a.click();a.remove();
  setTimeout(function(){URL.revokeObjectURL(u)},1000);
  msg("Pobrano index.html. Wgraj go na hosting w miejsce starego pliku.");
}
async function zapisz(){
  try{
    var a=await claude.use("artifact");
    if(!a){msg("Zapis na claude.ai działa tylko na koncie właściciela.");return}
    msg("Zapisuję...");
    await a.publish(html());
  }catch(e){msg("Nie udało się zapisać: "+(e&&e.message?e.message:e.code||"błąd"))}
}
document.getElementById("admin-open").onclick=function(){
  var ad=document.getElementById("admin"),body=document.getElementById("admin-body");
  ad.hidden=false;body.innerHTML="";
  var p=el("input");p.type="password";p.placeholder="Hasło admina";p.autocomplete="off";
  var b=el("button","btn","Wejdź");b.type="button";
  var go=async function(){if(await sha(p.value)===HASH){msg("");panel()}else msg("Błędne hasło.")};
  b.onclick=go;p.onkeydown=function(e){if(e.key==="Enter")go()};
  body.appendChild(p);body.appendChild(b);p.focus();ad.scrollIntoView();
};
var kb=document.getElementById("kontakt-btn");
kb.addEventListener("click",function(){
  var done=function(){kb.textContent="Skopiowano";setTimeout(function(){kb.textContent="Skopiuj nick"},2000)};
  if(navigator.clipboard)navigator.clipboard.writeText(stan.discord.nick||"").then(done,function(){});
});
document.getElementById("rok").textContent=new Date().getFullYear();
render();
</script>


<script async="" src="/.netlify/scripts/hud?variant=public" data-nf-variant="public" data-netlify-site-id="daf0c345-fcfc-4a93-b47b-e9738a1ea8da" data-app-host="app.netlify.com"></script>
<iframe id="nl-badge-frame" title="Powered by Netlify" srcdoc="&lt;!doctype html&gt;&lt;html&gt;&lt;head&gt;&lt;meta charset=&quot;utf-8&quot;&gt;&lt;meta name=&quot;color-scheme&quot; content=&quot;dark&quot;&gt;&lt;style&gt;
    :root{--nl-vw:1920px;--nl-vh:917px}
    *{box-sizing:border-box}
    html,body{margin:0;padding:0;background:transparent;overflow:hidden}
    body{display:flex;align-items:flex-end;justify-content:flex-end;height:100vh;
      padding:8px 18px 18px 8px;
      font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.5;color:#f4f9f9;-webkit-font-smoothing:antialiased}
    .nl-wrap{display:flex;flex-direction:column;align-items:flex-end;gap:10px;width:max-content;max-width:calc(var(--nl-vw,100vw) - 26px)}
    button{font-family:inherit;cursor:pointer}
    :focus-visible{outline:2px solid #32e6e2;outline-offset:2px;border-radius:6px}
    .nl-icon-btn{position:relative;flex:none;width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border-radius:8px;border:1px solid transparent;background:transparent;color:#d5e3e6;transition:background .15s ease,color .15s ease}
    .nl-icon-btn:hover{background:rgba(255,255,255,0.08);color:#f4f9f9}
    .nl-tap::after{content:&quot;&quot;;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
      width:max(100%,44px);height:max(100%,44px)}
    @keyframes nl-rise{from{opacity:0;transform:translateY(10px) scale(.97)}to{opacity:1;transform:none}}
    @media (prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;transition:none!important}}
  
      .nl-card{position:relative;display:none;width:min(340px,calc(var(--nl-vw,100vw) - 26px));max-height:calc(var(--nl-vh,100vh) - 84px);overflow-y:auto;background:linear-gradient(180deg,#132832 0%,#0e1e25 100%);border:1px solid rgba(255,255,255,0.09);border-radius:18px;padding:18px;transform-origin:bottom right;animation:nl-rise .3s cubic-bezier(.34,1.4,.4,1) both}
      .nl-card.open{display:block}
      .nl-card-close{position:absolute;top:10px;right:10px}
      .nl-card h2{margin:0;padding-right:30px;font-size:16px;font-weight:750;letter-spacing:-0.015em;line-height:1.35}
      .nl-card h2 em{font-style:normal;background:linear-gradient(90deg,#32e6e2,#4d7cfe,#9a6bff);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent}
      .nl-card p{margin:8px 0 0;font-size:12.5px;color:#d5e3e6}
      .nl-prompt{position:relative;margin-top:14px;background:#10222b;border:1px solid rgba(255,255,255,0.09);border-radius:14px;padding:10px 12px;transition:border-color .15s ease,box-shadow .15s ease}
      .nl-prompt:focus-within{border-color:#05bdba;box-shadow:0 0 0 3px rgba(5,189,186,0.18)}
      .nl-prompt textarea{display:block;width:100%;height:38px;resize:none;border:0;outline:none;background:transparent;color:#f4f9f9;font:inherit;font-size:13px;line-height:19px;padding:0 28px 0 0}
      .nl-prompt textarea::placeholder{color:#a9bdc2}
      .nl-send{position:absolute;right:9px;bottom:9px;width:24px;height:24px;flex:none;display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:50%;background:#05bdba;color:#02191b;transition:background .15s ease}
      .nl-send:hover{background:#32e6e2}
      @media (pointer: coarse){
        .nl-prompt textarea{font-size:16px;line-height:21px;height:42px}
      }
      .nl-or{display:flex;align-items:center;gap:10px;margin:12px 0;font-size:10.5px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#a9bdc2}
      .nl-or::before,.nl-or::after{content:&quot;&quot;;flex:1;height:1px;background:rgba(255,255,255,0.09)}
      .nl-drop{display:flex;align-items:center;justify-content:space-between;gap:6px;text-decoration:none;background:#1b3a45;border:1px solid rgba(255,255,255,0.09);border-radius:10px;padding:10px 12px;font-size:13px;font-weight:600;color:#cfe0e3;transition:background .15s ease,color .15s ease,border-color .15s ease}
      .nl-drop:hover{background:#224753;color:#f4f9f9;border-color:rgba(50,230,226,0.3)}
      .nl-drop .nl-arrow{transition:transform .18s cubic-bezier(.34,1.4,.4,1)}
      .nl-drop:hover .nl-arrow{transform:translateX(3px)}
      .nl-badge{display:flex;align-items:center;gap:9px;white-space:nowrap;border:1px solid rgba(255,255,255,0.09);background:linear-gradient(180deg,#142b34,#0e1e25);color:#f4f9f9;border-radius:999px;padding:9px 14px 9px 11px;font-size:13px;font-weight:600;letter-spacing:0.01em;transition:border-color .2s ease}
      .nl-badge:hover{border-color:rgba(50,230,226,0.26)}
      .nl-hide{display:block;width:100%;margin-top:10px;border:0;background:transparent;color:#a9bdc2;font-size:11.5px;font-weight:600;padding:4px;border-radius:8px;transition:color .15s ease}
      .nl-hide:hover{color:#d5e3e6;text-decoration:underline}
      .nl-badge-label{color:#d5e3e6;font-weight:500}
      .nl-badge-brand{font-weight:750}
    &lt;/style&gt;&lt;/head&gt;&lt;body&gt;
      &lt;div class=&quot;nl-wrap&quot;&gt;
        &lt;section class=&quot;nl-card&quot; id=&quot;nl-card&quot; aria-label=&quot;Build your own site on Netlify&quot;&gt;
          &lt;button type=&quot;button&quot; class=&quot;nl-icon-btn nl-tap nl-card-close&quot; id=&quot;nl-card-close&quot; aria-label=&quot;Close&quot;&gt;&lt;svg width=&quot;14&quot; height=&quot;14&quot; viewBox=&quot;0 0 16 16&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;1.9&quot; stroke-linecap=&quot;round&quot; aria-hidden=&quot;true&quot;&gt;&lt;path d=&quot;M4.5 4.5 11.5 11.5M11.5 4.5 4.5 11.5&quot;/&gt;&lt;/svg&gt;&lt;/button&gt;
          &lt;h2&gt;&lt;em&gt;Build your own site with Netlify&lt;/em&gt;&lt;/h2&gt;
          &lt;p&gt;Describe what you want, and an AI agent designs, builds and deploys it in minutes.&lt;/p&gt;
          &lt;form class=&quot;nl-prompt&quot; action=&quot;https://app.netlify.com/start&quot; method=&quot;get&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;
            &lt;textarea name=&quot;prompt&quot; rows=&quot;2&quot; required maxlength=&quot;300&quot; autocomplete=&quot;off&quot;
                      enterkeyhint=&quot;go&quot;
                      placeholder=&quot;A shop for my handmade surfboards&amp;hellip;&quot;
                      aria-label=&quot;Describe the site you want to build&quot;&gt;&lt;/textarea&gt;
            &lt;button type=&quot;submit&quot; class=&quot;nl-send nl-tap&quot; aria-label=&quot;Build this site&quot;&gt;&lt;svg width=&quot;13&quot; height=&quot;13&quot; viewBox=&quot;0 0 16 16&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;1.8&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot; aria-hidden=&quot;true&quot;&gt;&lt;path d=&quot;M8 12.75v-9.5M3.9 7.35 8 3.25l4.1 4.1&quot;/&gt;&lt;/svg&gt;&lt;/button&gt;
            &lt;input type=&quot;hidden&quot; name=&quot;utm_source&quot; value=&quot;netlify_badge&quot;&gt;
            &lt;input type=&quot;hidden&quot; name=&quot;utm_campaign&quot; value=&quot;loops&quot;&gt;
            &lt;input type=&quot;hidden&quot; name=&quot;utm_medium&quot; value=&quot;owned&quot;&gt;
            &lt;input type=&quot;hidden&quot; name=&quot;utm_content&quot; value=&quot;prompt&quot;&gt;
            &lt;input type=&quot;hidden&quot; name=&quot;utm_id&quot; value=&quot;daf0c345-fcfc-4a93-b47b-e9738a1ea8da&quot;&gt;
            
          &lt;/form&gt;
          &lt;div class=&quot;nl-or&quot;&gt;&lt;span&gt;or&lt;/span&gt;&lt;/div&gt;
          &lt;a class=&quot;nl-drop&quot; href=&quot;https://app.netlify.com/drop?utm_source=netlify_badge&amp;utm_campaign=loops&amp;utm_medium=owned&amp;utm_content=drop&amp;utm_id=daf0c345-fcfc-4a93-b47b-e9738a1ea8da&quot; target=&quot;_blank&quot; rel=&quot;noopener&quot;&gt;
            &lt;span&gt;Drop a site you already have&lt;/span&gt;&lt;span class=&quot;nl-arrow&quot; aria-hidden=&quot;true&quot;&gt;&amp;rarr;&lt;/span&gt;
